{
  "name": "redeye",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-first off-hours plans for tokenized stocks on BNB Smart Chain.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "probe": "node scripts/probe.mjs",
    "probe:status": "node scripts/probe.mjs --status-only",
    "verify": "node scripts/verify-receipt.mjs",
    "identity:register": "node scripts/register-identity.mjs",
    "plan-account:live": "node scripts/live-plan-account.mjs",
    "plan-account:deploy": "node scripts/deploy-plan-account.mjs",
    "plan-account:delegate": "node scripts/delegate-plan-account.mjs",
    "passkey:deploy": "node scripts/deploy-passkey-factory.mjs",
    "study:offhours": "node scripts/study/offhours.mjs",
    "study:offhours:test": "node --test scripts/study/offhours.test.mjs",
    "packages:build": "pnpm --filter @redeye/shared build && pnpm --filter @redeye/clients build && pnpm --filter @redeye/core build",
    "agent:build": "pnpm packages:build && pnpm --filter @redeye/agent build",
    "agent:start": "pnpm --filter @redeye/agent start",
    "web:build": "pnpm --filter @redeye/web build",
    "contract:test": "forge test --root contracts --offline",
    "contract:test:fork": "forge test --root contracts --match-contract PlanAccountForkTest -vvv",
    "contract:build": "forge build --root contracts --offline",
    "pretest": "pnpm packages:build",
    "test": "pnpm study:offhours:test && node --test scripts/reconcile.test.mjs skills/redeye/scripts/redeye.test.mjs && pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "lint": "pnpm --recursive --if-present lint",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "viem": "^2.21.54",
    "vitest": "^4.1.11"
  }
}
