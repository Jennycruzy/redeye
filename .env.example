# Redeye runtime configuration. Never commit a populated .env.
NODE_ENV=development
EXECUTION_ENABLED=false

# Public data and chain endpoints
BSC_RPC_URL_LIVE=https://bsc-dataseed.bnbchain.org
BSC_RPC_URL_ARCHIVE=https://bsc-mainnet.public.blastapi.io
BSC_RPC_URL_LOGS=
# Required before any SEC request: use a real contact address.
SEC_USER_AGENT=

# Binance Web3 / Agentic Wallet (required for authenticated probes)
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=

# Agent/runtime secrets (kept empty until the owner provisions them)
AGENT_PRIVATE_KEY=
PLANBOOK_ADDRESS=
LLM_PROVIDER=
LLM_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
OWNER_API_TOKEN=
WEB_ORIGIN=
REDEYE_DB_PATH=.redeye/redeye.sqlite
AGENT_PORT=8787
VITE_AGENT_URL=
REDEYE_DATA_ROOT=data
REDEYE_POOL_MAP_PATH=data/raw/offhours/pools.json
REDEYE_DERIVED_ROOT=data/derived/offhours
# Optional live coverage override. The default excludes the two known source-quality exclusions.
REDEYE_PRICE_TICKERS=

# Receipt hosting
S3_BUCKET_RECEIPTS=
AWS_REGION=eu-west-1

# Optional probe overrides
PROBE_DATE=
PROBE_POOL_ADDRESS=

# 24/7 price feed (data only; never traded)
HYPERLIQUID_INFO_URL=https://api.hyperliquid.xyz/info
PRICE_MAX_AGE_S=120

# Per-plan permission and newcomer accounts
PLANACCOUNT_ADDRESS=
# Approved router for the PlanAccount permission path; defaults to Pancake V3 SmartRouter on BSC.
PLAN_ACCOUNT_ROUTER_ADDRESS=
PUBLIC_AGENT_URL=
PUBLIC_SITE_URL=
PUBLIC_REPO_URL=
ERC8004_AGENT_ID=
JOB_BUYER_PRIVATE_KEY=
PLAN_JOB_HOOK_ADDRESS=
TEAM_JOB_LIMIT=0
# self | b402-web3 (BINANCE_WEB3_API_KEY/_SECRET) | b402-merchant (B402_* below)
X402_SETTLEMENT=
B402_BASE_URL=
B402_CLIENT_ID=
B402_ACCESS_TOKEN=
B402_PRIVATE_KEY_B64=
ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032
GAS_SPONSOR_DAILY_CAP_USD=
GAS_SPONSOR_PER_ACCOUNT_CAP_USD=
PASSKEY_RP_ID=
PASSKEY_FACTORY_ADDRESS=
TELEGRAM_BOT_TOKEN=
# Creation stays off unless both caps are explicit. The fee cap is in wei on BSC.
PASSKEY_SPONSOR_DAILY_LIMIT=0
PASSKEY_SPONSOR_MAX_FEE_WEI=

# Card purchase provider (whichever is approved)
ONCHAINPAY_CLIENT_ID=
ONCHAINPAY_PEM_PATH=
TRANSAK_API_KEY=
