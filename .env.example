# Redeye M0 / runtime configuration. Never commit a populated .env.
NODE_ENV=development
EXECUTION_ENABLED=false

# Public data and chain endpoints
BSC_RPC_URL_LIVE=https://bsc-dataseed.bnbchain.org
BSC_RPC_URL_ARCHIVE=https://bsc-mainnet.public.blastapi.io
BSC_RPC_URL_LOGS=
SEC_USER_AGENT=Redeye (contact@example.com)

# Binance Web3 / Agentic Wallet (required for authenticated M0 probes)
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=

# Agent/runtime secrets (kept empty until the owner provisions them)
AGENT_PRIVATE_KEY=
PLANBOOK_ADDRESS=
LLM_PROVIDER=
LLM_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
OWNER_API_TOKEN=
WEB_ORIGIN=
REDEYE_DB_PATH=.redeye/redeye.sqlite
AGENT_PORT=8787
VITE_AGENT_URL=

# Receipt hosting
S3_BUCKET_RECEIPTS=
AWS_REGION=eu-west-1

# Optional M0 overrides
M0_DATE=
M0_POOL_ADDRESS=
